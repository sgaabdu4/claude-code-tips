#!/bin/bash
# Gate hook: nudges Claude toward codebase-memory-mcp for code discovery.
# First Grep/Glob/Read/Search per session -> block. Subsequent -> allow.
# Keyed on session_id from the hook's stdin JSON. $PPID is not the Claude Code
# process: each hook command runs in a fresh shell, so $PPID changes on every
# call and the gate would block every Grep/Glob/Read instead of only the first.
# $PPID stays as a fallback when jq is missing or stdin has no session_id.
SESSION=$(jq -r '.session_id // empty' 2>/dev/null)
SESSION=${SESSION//[^A-Za-z0-9_-]/}
SESSION=${SESSION:-$PPID}
GATE=/tmp/cbm-code-discovery-gate-$SESSION
MARKER=/tmp/cbm-mcp-used-$SESSION
# Stale-marker cleanup removed: /tmp is wiped on reboot (macOS) and PPID
# collisions within a 24h window are rare. Cleanup via `find` was banned-pattern
# adjacent and ran on every hook invocation for marginal gain.
# Allow if a CBM tool ran already this session, OR if we already blocked once.
if [ -f "$MARKER" ] || [ -f "$GATE" ]; then
    exit 0
fi
touch "$GATE"
echo 'BLOCKED: For code discovery, use codebase-memory-mcp tools first: search_graph(name_pattern) to find functions/classes, trace_path() for call chains, get_code_snippet(qualified_name) to read source. If the graph is not indexed yet, call index_repository first. Fall back to Grep/Glob/Read only for text content search. If you need Grep, retry.' >&2
exit 2
