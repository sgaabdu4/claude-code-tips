#!/bin/bash
# Hook shim: resolve a CLI by name, then exec it with the remaining args.
#
# Claude Code spawns hook commands without sourcing the user's shell rc, so the
# hook PATH is whatever the Claude Code process inherited. Tools installed into
# rc-added dirs are therefore invisible to hooks even though the same command
# works in the Bash tool (which does load the profile). A bare `rtk hook claude`
# in settings.json dies with `rtk: No such file or directory (os error 2)`.
#
# Headroom bundles rtk into ~/.headroom/bin, which no installer adds to PATH —
# see headroomlabs-ai/headroom#487. pip --user and npm -g land in equally
# unpredictable places. We probe the known install dirs instead.
#
# A missing binary is NOT an error: these hooks are optional accelerators, so we
# exit 0 and let the tool call through rather than blocking work on a tool the
# user may have deliberately skipped.
#
# Usage:
#   run-cli-hook <bin> [args...]   exec <bin> (exit 0 if <bin> is not installed)
#   run-cli-hook --which <bin>     print resolved path, exit 1 if unresolvable
set -uo pipefail

WHICH=0
if [ "${1:-}" = "--which" ]; then
  WHICH=1
  shift
fi

BIN=${1:-}
[ -n "$BIN" ] || exit $(( WHICH ))
shift 2>/dev/null || true

# `-x` is only a permission bit. A wrapper script whose shebang interpreter has
# since been deleted passes every static test and then fails execve with ENOENT
# naming the *script*, which is how a live, non-symlink ~/.headroom/bin/rtk kept
# producing `rtk: No such file or directory (os error 2)` while --which happily
# reported it as resolved. Reported in issue #2.
usable() {
  local cand=$1 magic line interp
  [ -x "$cand" ] || return 1
  # Two bytes first: a real binary can run for megabytes before a newline.
  IFS= read -r -n 2 magic < "$cand" 2>/dev/null || return 0
  [ "$magic" = "#!" ] || return 0
  IFS= read -r line < "$cand" 2>/dev/null || return 0
  interp=${line#\#!}
  interp=${interp#"${interp%%[![:space:]]*}"}
  interp=${interp%%[[:space:]]*}
  [ -n "$interp" ] || return 0
  [ -x "$interp" ] || return 1
  # `#!/usr/bin/env foo` defers the real lookup to PATH at exec time.
  if [ "${interp##*/}" = "env" ]; then
    local rest prog
    rest=${line#\#!}
    rest=${rest#*env}
    prog=${rest#"${rest%%[![:space:]]*}"}
    prog=${prog%%[[:space:]]*}
    [ -z "$prog" ] || command -v "$prog" >/dev/null 2>&1 || return 1
  fi
  return 0
}

resolve_cli() {
  local name=$1 dir user_base override override_var
  local -a path_dirs

  # Explicit override wins: CCT_RTK_BIN, CCT_CONTEXT_MODE_BIN, ...
  override_var="CCT_$(echo "$name" | tr '[:lower:].-' '[:upper:]__')_BIN"
  override=${!override_var:-}
  if [ -n "$override" ] && usable "$override"; then
    printf '%s\n' "$override"; return 0
  fi

  # PATH first — respects a user who has already wired things up correctly.
  # Walked entry by entry rather than via `command -v` so one unusable early
  # match cannot mask a working copy further down.
  IFS=: read -r -a path_dirs <<<"${PATH:-}"
  for dir in "${path_dirs[@]}"; do
    [ -n "$dir" ] || continue
    if usable "$dir/$name"; then printf '%s\n' "$dir/$name"; return 0; fi
  done

  # Static probes: pure builtins + file tests, no subprocess cost. This runs on
  # every Bash tool call, so keep the common cases first.
  for dir in \
    "$HOME/.headroom/bin" \
    "$HOME/.local/bin" \
    "/opt/homebrew/bin" \
    "/usr/local/bin" \
    "$HOME/.cargo/bin" \
    "$HOME/.bun/bin" \
    "$HOME/.volta/bin" \
    "$HOME/.npm-global/bin"
  do
    if usable "$dir/$name"; then printf '%s\n' "$dir/$name"; return 0; fi
  done

  # Glob probes: pip --user on stock macOS python, and node version managers.
  for dir in \
    "$HOME/Library/Python"/*/bin \
    "$HOME/.nvm/versions/node"/*/bin \
    "$HOME/.local/share/mise/installs/node"/*/bin
  do
    if usable "$dir/$name"; then printf '%s\n' "$dir/$name"; return 0; fi
  done

  # Last resort: ask python3 where `pip install --user` actually points. Costs a
  # process, so it only runs when everything cheap has already missed.
  if user_base=$(python3 -c 'import site; print(site.USER_BASE)' 2>/dev/null) \
     && [ -n "$user_base" ] && usable "$user_base/bin/$name"; then
    printf '%s\n' "$user_base/bin/$name"; return 0
  fi

  return 1
}

if BIN_PATH=$(resolve_cli "$BIN"); then
  [ "$WHICH" -eq 1 ] && { printf '%s\n' "$BIN_PATH"; exit 0; }
  exec "$BIN_PATH" "$@"
fi

# Not installed. --which reports it; hook mode stays out of the way.
[ "$WHICH" -eq 1 ] && exit 1
exit 0
